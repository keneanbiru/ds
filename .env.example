# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# RabbitMQ Configuration
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin

# Database Names (for service connections)
AUTH_DB_NAME=auth_db
SHIPMENT_DB_NAME=shipment_db
WAREHOUSE_DB_NAME=warehouse_db
TRACKING_DB_NAME=tracking_db

# Service URLs (for inter-service communication)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

# JWT Configuration (will be used in later milestones)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h

# Service Ports (will be used in later milestones)
AUTH_SERVICE_PORT=3001
SHIPMENT_SERVICE_PORT=3002
WAREHOUSE_SERVICE_PORT=3003
TRACKING_SERVICE_PORT=3004
API_GATEWAY_PORT=3000
